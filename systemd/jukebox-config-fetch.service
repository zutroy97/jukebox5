[Unit]
Description=Fetch a config.ini override from the Mac before jukebox starts
After=network-online.target
Wants=network-online.target
Before=jukebox.service

[Service]
Type=oneshot
User=simonbs
Group=simonbs
WorkingDirectory=/home/simonbs/jukebox5/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/simonbs/jukebox5/venv/bin/python3 fetch_config_from_mac.py

# Deliberately NOT sandboxed like jukebox.service (no ProtectSystem=strict/
# ProtectHome=read-only) -- this oneshot's whole job is writing config.ini,
# which jukebox.service's sandboxing specifically prevents it from doing
# itself (confirmed the hard way: EROFS writing straight over config.ini
# from inside that unit).
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
