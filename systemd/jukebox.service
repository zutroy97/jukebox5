[Unit]
Description=Jukebox5 application
# Full boot order this depends on: mosquitto, then shairport-sync (see
# systemd/shairport-sync.service.d/override.conf for why shairport-sync
# itself needs to come after mosquitto), then this unit -- so shairport-sync
# has already had a chance to establish both its MQTT connection and an
# active AirPlay session before the jukebox starts subscribing, rather than
# racing it.
After=network-online.target mosquitto.service shairport-sync.service jukebox-config-fetch.service
Wants=network-online.target
# Not Requires= for shairport-sync.service/jukebox-config-fetch.service --
# both are still fine to start after if they're not up for some reason
# (song metadata degrades gracefully to the SSH-based fallback in main.py;
# jukebox-config-fetch.service always exits 0 regardless). Wants= still
# means "start them first if they're going to start at all" without making
# this unit's own startup depend on either succeeding.
Wants=shairport-sync.service jukebox-config-fetch.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=simonbs
Group=simonbs
WorkingDirectory=/home/simonbs/jukebox5/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/simonbs/jukebox5/venv/bin/python3 main.py
Restart=on-failure
RestartSec=5s

# Sandboxing rather than a separate Unix user: makes the whole filesystem
# read-only to this process (independent of whether the underlying disk
# is actually mounted read-only yet -- see docs/SPECIFICATION.md), with
# one small tmpfs-backed exception it doesn't currently need but is
# reserved for future use. The app itself makes no runtime writes today.
ProtectSystem=strict
ProtectHome=read-only
RuntimeDirectory=jukebox
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
